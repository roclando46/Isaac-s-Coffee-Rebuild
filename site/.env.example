# Copy to .env.local for local work. In Vercel, add these under Project, Settings, Environment Variables.
# Never commit real values: this repository is public.

# Site
NEXT_PUBLIC_SITE_URL=https://isaacscoffee.co.uk

# Stripe (Dashboard, Developers, API keys). Use test keys until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Postgres (Vercel, Storage, Neon). Vercel fills this in when you connect the database.
DATABASE_URL=

# Resend (resend.com, API keys). Verify isaacscoffee.co.uk as a sending domain first.
RESEND_API_KEY=
EMAIL_FROM=Isaac's Coffee <hello@isaacscoffee.co.uk>
# Where contact form messages and drinks orders go
CAFE_INBOX=hello@isaacscoffee.co.uk

# Admin area at /admin. Choose a long password.
ADMIN_PASSWORD=
# Random string used to sign admin sessions and email links. Generate with: openssl rand -hex 32
APP_SECRET=

# Vercel Cron sends this as a bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=
